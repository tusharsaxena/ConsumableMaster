# Libraries
embeds.xml

# Locales
locales\enUS.lua

# Core
# Namespace.lua first: names the private addon table (`local addonName, NS = ...`).
# ConsumableMaster.lua promotes NS to the AceAddon object and owns the DB
# bootstrap + recompute pipeline. Constants (KCM.PREFIX / KCM.Say), Compat (spec
# + spell API seam), State (session-only flags), and Database (SV migrations)
# load next; the pure engine modules (SpecHelper → Classifier) follow.
core\Namespace.lua
core\ConsumableMaster.lua
core\Bus.lua
core\Constants.lua
core\Compat.lua
core\State.lua
core\Database.lua
core\Debug.lua
core\SpecHelper.lua
core\TooltipCache.lua
core\BagScanner.lua
core\Classifier.lua
core\SlashCommands.lua

# Defaults
defaults\Categories.lua
defaults\Defaults_StatPriority.lua
defaults\Defaults_Food.lua
defaults\Defaults_Drink.lua
defaults\Defaults_StatFood.lua
defaults\Defaults_HPPot.lua
defaults\Defaults_MPPot.lua
defaults\Defaults_Healthstone.lua
defaults\Defaults_CombatPot.lua
defaults\Defaults_Flask.lua

# Modules
modules\Ranker.lua
modules\Selector.lua
modules\MacroManager.lua
modules\DebugLog.lua
modules\KCMIconButton.lua
modules\KCMScoreButton.lua
modules\KCMMacroDragIcon.lua
modules\KCMItemRow.lua

# Settings
# settings/Panel.lua first: it creates KCM.Settings.{Helpers, Schema, builders}
# and exposes KCM.Settings.RegisterTab, which the per-tab modules below call.
# It also publishes the KCM.Options shim (Register/Refresh/RequestRefresh/Open)
# so the core / pipeline callers keep working unchanged.
settings\Panel.lua
settings\General.lua
settings\StatPriority.lua
settings\Category.lua
